<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17">
  <diagram id="database-schema" name="MongoDB Schema">
    <mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SuperNova MongoDB / Mongoose Data Model" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="500" y="25" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="application" value="MembershipApplication&#xa;------------------------&#xa;fullName, email, phone&#xa;fieldOfStudy, university&#xa;motivation, skills[], interests[]&#xa;preferredDepartment -> Department&#xa;status: pending | accepted | rejected&#xa;reviewedBy -> User&#xa;reviewedAt, decisionNote&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D93025;fontColor=#A50E0E;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="300" height="280" as="geometry"/></mxCell>
        <mxCell id="invite" value="InviteToken&#xa;------------------------&#xa;user -> User&#xa;application -> MembershipApplication&#xa;tokenHash unique, hidden&#xa;expiresAt TTL&#xa;usedAt&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#B06000;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="260" height="220" as="geometry"/></mxCell>
        <mxCell id="user" value="User&#xa;------------------------&#xa;fullName, email unique&#xa;passwordHash hidden&#xa;phone&#xa;roles[]: lead | hr | department_head | member&#xa;departments[] -> Department&#xa;status: invited | active | suspended&#xa;points, completedTasksCount caches&#xa;lastLoginAt, timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#174EA6;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="320" height="300" as="geometry"/></mxCell>
        <mxCell id="department" value="Department&#xa;------------------------&#xa;name unique&#xa;slug unique&#xa;description, imageUrl&#xa;heads[] -> User&#xa;isActive&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#188038;fontColor=#137333;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="130" width="250" height="220" as="geometry"/></mxCell>
        <mxCell id="registration" value="RegistrationSettings&#xa;------------------------&#xa;key: global unique&#xa;isOpenOverride&#xa;updatedBy -> User&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;fontColor=#7627BB;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1500" y="140" width="250" height="190" as="geometry"/></mxCell>
        <mxCell id="notification" value="Notification&#xa;------------------------&#xa;recipient -> User&#xa;type, title, message, link&#xa;readAt&#xa;relatedType, relatedId&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;fontColor=#00695C;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="260" height="210" as="geometry"/></mxCell>
        <mxCell id="assignment" value="TaskAssignment&#xa;------------------------&#xa;task -> Task&#xa;member -> User&#xa;unique(task, member)&#xa;status: claimed | left | submitted | approved | rejected&#xa;claimedAt, leftAt, submittedAt&#xa;submissionNote, submissionUrl&#xa;reviewedBy -> User&#xa;reviewedAt, reviewNote, timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;fontColor=#7627BB;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="330" height="300" as="geometry"/></mxCell>
        <mxCell id="task" value="Task&#xa;------------------------&#xa;title, description&#xa;type: global | department&#xa;department -> Department optional&#xa;createdBy -> User&#xa;deadline, maxAssignees, assignedCount&#xa;status: open | filled | in_progress | submitted | completed | cancelled&#xa;points, notes, timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAED;strokeColor=#5F6368;fontColor=#3C4043;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="340" height="300" as="geometry"/></mxCell>
        <mxCell id="event" value="Event&#xa;------------------------&#xa;title, slug unique&#xa;description&#xa;type: workshop | event | announcement&#xa;startsAt, endsAt, location&#xa;status: draft | published | archived&#xa;createdBy -> User&#xa;coverImage, tag, subtitle&#xa;presenterName, link, timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D93025;fontColor=#A50E0E;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1220" y="480" width="310" height="280" as="geometry"/></mxCell>
        <mxCell id="content" value="SiteContent&#xa;------------------------&#xa;kind: leader | achievement&#xa;Leader: roleTag, fullName, subtitleRole&#xa;Achievement: title, subtitle, link&#xa;description, imageUrl&#xa;sortOrder&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#188038;fontColor=#137333;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1610" y="500" width="260" height="230" as="geometry"/></mxCell>
        <mxCell id="audit" value="AuditLog&#xa;------------------------&#xa;actor -> User&#xa;action&#xa;targetModel, targetId&#xa;changes&#xa;ip, userAgent&#xa;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#B06000;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="900" width="280" height="220" as="geometry"/></mxCell>
        <mxCell id="rule1" value="Rule 1: application acceptance creates an invited User and one-time InviteToken in a transaction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;fontColor=#3C4043;fontSize=13;dashed=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="560" height="70" as="geometry"/></mxCell>
        <mxCell id="rule2" value="Rule 2: Task defines work and capacity. TaskAssignment is the member-specific claim and review history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontColor=#3C4043;fontSize=13;dashed=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="560" height="70" as="geometry"/></mxCell>
        <mxCell id="rule3" value="Rule 3: approved TaskAssignments are leaderboard truth. User point counters are caches." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#188038;fontColor=#3C4043;fontSize=13;dashed=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1230" y="920" width="550" height="70" as="geometry"/></mxCell>
        <mxCell id="rule4" value="Rule 4: MongoDB replica-set transactions are mandatory for cross-document invariants." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#3C4043;fontSize=13;dashed=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1230" y="1020" width="550" height="70" as="geometry"/></mxCell>
        <mxCell id="ea1" edge="1" parent="1" source="application" target="department" value="preferredDepartment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#188038;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="80"/><mxPoint x="1280" y="80"/></Array></mxGeometry></mxCell>
        <mxCell id="ea2" edge="1" parent="1" source="application" target="user" value="reviewedBy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A73E8;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ei1" edge="1" parent="1" source="invite" target="application" value="application" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#D93025;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ei2" edge="1" parent="1" source="invite" target="user" value="user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A73E8;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu1" edge="1" parent="1" source="user" target="department" value="departments[]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#188038;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed1" edge="1" parent="1" source="department" target="user" value="heads[]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#1A73E8;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="370"/></Array></mxGeometry></mxCell>
        <mxCell id="er1" edge="1" parent="1" source="registration" target="user" value="updatedBy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9334E6;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="en1" edge="1" parent="1" source="notification" target="user" value="recipient" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#00897B;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eas1" edge="1" parent="1" source="assignment" target="task" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F6368;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eas2" edge="1" parent="1" source="assignment" target="user" value="member / reviewedBy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A73E8;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et1" edge="1" parent="1" source="task" target="department" value="department" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#188038;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et2" edge="1" parent="1" source="task" target="user" value="createdBy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A73E8;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee1" edge="1" parent="1" source="event" target="user" value="createdBy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A73E8;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eau1" edge="1" parent="1" source="audit" target="user" value="actor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#F9AB00;fontColor=#3C4043;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
